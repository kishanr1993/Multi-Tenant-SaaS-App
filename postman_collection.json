                  "pm.test(\"Authenticated successfully as org_admin\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.user.role).to.eql(\"org_admin\");",
                  "    pm.expect(jsonData.data.user.organization.name).to.eql(\"Acme Corporation\");",
                  "});",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    pm.collectionVariables.set(\"admin_token\", jsonData.data.token);",
                  "}"
