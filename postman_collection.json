              "raw": "{\n    \"name\": \"E-Commerce Microservices Upgrade\",\n    \"description\": \"Migrate monolithic checkout to scalable microservices.\",\n    \"start_date\": \"2026-11-20\",\n    \"end_date\": \"2027-02-28\",\n    \"manager_id\": 3,\n    \"status\": \"active\",\n    \"developer_ids\": [4, 5]\n}"
